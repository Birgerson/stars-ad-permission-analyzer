// The Stars window: header, tab bar and the eight tabs. Compiled by the
// `slint!` macro in src/main.rs (ADR 0082). Design tokens live in
// theme/, reusable building blocks in components/, view models in
// models.slint.

import {
    TabWidget,
    VerticalBox,
    HorizontalBox,
    GridBox,
    GroupBox,
    LineEdit,
    Button,
    CheckBox,
    ScrollView,
    SpinBox,
    ComboBox,
    Palette,
} from "std-widgets.slint";
import { PrimaryButton, DangerButton } from "components/buttons.slint";
import { HeaderBar } from "components/header.slint";
import { HelpTip } from "components/help-tip.slint";
import { TrustDomainFields } from "components/trust-domain-fields.slint";
import {
    TrusteeRowVm,
    DiagnosticVm,
    GroupMemberVm,
    ShareVm,
    TrustVm,
    GraphTextVm,
    GraphNodeVm,
    StepVm,
    ScanRowVm,
    ScanErrorVm,
    RiskItemVm,
    ScanRunVm,
    RunErrorVm,
    DeltaRowVm,
    IdentitySuggestionVm,
} from "models.slint";
import { Theme } from "theme/theme.slint";

import { TrustsState, TrustsTab } from "tabs/trusts.slint";

import { SharesState, SharesTab } from "tabs/shares.slint";

import { AppState } from "app-state.slint";

import { InfoState, InfoTab } from "tabs/info.slint";

import { DeltaState, DeltaTab } from "tabs/delta.slint";

import { GraphState, GraphTab } from "tabs/graph.slint";

import { GroupsState, GroupsTab } from "tabs/groups.slint";

import { ScanState, ScanTab } from "tabs/scan.slint";

import { AnalyzeState, AnalyzeTab } from "tabs/analyze.slint";

// Re-exported for the Rust side (the generated API stays the same).
export { Theme } from "theme/theme.slint";
export { AnalyzeState } from "tabs/analyze.slint";
export { ScanState } from "tabs/scan.slint";
export { GroupsState } from "tabs/groups.slint";
export { GraphState } from "tabs/graph.slint";
export { DeltaState } from "tabs/delta.slint";
export { InfoState } from "tabs/info.slint";
export { AppState } from "app-state.slint";
export { SharesState } from "tabs/shares.slint";
export { TrustsState } from "tabs/trusts.slint";
export {
    TrusteeRowVm,
    DiagnosticVm,
    GroupMemberVm,
    ShareAceVm,
    ShareVm,
    TrustVm,
    GraphTextVm,
    GraphNodeVm,
    StepVm,
    ScanRowVm,
    ScanErrorVm,
    RiskItemVm,
    ScanRunVm,
    RunErrorVm,
    DeltaRowVm,
    IdentitySuggestionVm,
} from "models.slint";

export component MainWindow inherits Window {
    title: "Stars — AD Permission Analyzer";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 800px;
    min-height: 560px;
    background: Theme.bg-app;
    // Stars only runs on Windows Server hosts (see AGENTS.md).
    // Arial is guaranteed and renders consistently across editions.
    default-font-family: "Arial";

    // Pin Slint widget palette to our explicit toggle so the
    // host theme cannot override readability. Reactive binding via
    // a tracking property + `changed` callback (Slint 1.6+).
    property <ColorScheme> _palette-scheme: Theme.dark ? ColorScheme.dark : ColorScheme.light;
    init => {
        Palette.color-scheme = self._palette-scheme;
    }
    changed _palette-scheme => {
        Palette.color-scheme = self._palette-scheme;
    }

    VerticalLayout {
        spacing: 0;

        HeaderBar {
            app-title: "Stars";
            app-subtitle: "AD Permission Analyzer";
            version-text: AppState.version;
        }

        // Content area with consistent padding around the TabWidget;
        // the TabWidget keeps its Slint default look but gets some air.
        Rectangle {
            background: Theme.bg-app;

            VerticalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-top: Theme.spacing-md;
                padding-bottom: Theme.spacing-md;

                TabWidget {
                    // Analyze — single-path analysis
                    Tab {
                        title: "Analyze";
                        AnalyzeTab {}
                    }

                    // Graph — the result as a diagram (ADR 0077, 0081)
                    Tab {
                        title: "Graph";
                        GraphTab {}
                    }

                    // Groups — which groups is a user in / who is in a group
                    Tab {
                        title: "Groups";
                        GroupsTab {}
                    }

                    // Scan Tree — a whole tree for one account
                    Tab {
                        title: "Scan Tree";
                        ScanTab {}
                    }

                    // Delta — two scan runs compared
                    Tab {
                        title: "Delta";
                        DeltaTab {}
                    }

                    // Trusts — the domain's trust inventory (read-only, L4)
                    Tab {
                        title: "Trusts";
                        TrustsTab {}
                    }

                    // Shares — a server's SMB shares and share-level DACL
                    Tab {
                        title: "Shares";
                        SharesTab {}
                    }

                    // Info — author, license, read-only limits, updates
                    Tab {
                        title: "Info";
                        InfoTab {}
                    }
                }
            }
        }
    }
}
