// The help tip next to a field: a circled "?".

import { Theme } from "../theme/theme.slint";

// Reusable help icon — a "?" in a drawn circle (ADR 0083: the character in
// the GUI's font, the circle a shape, no symbol-font glyph; a small "i"
// reads like a power symbol). On hover a small dark tooltip box appears
// right next to the icon. The tooltip is only shown while hovered, overlays
// its neighbors (Slint renders children over siblings) and disappears as
// soon as the mouse leaves.
export component HelpTip inherits Rectangle {
    in property <string> tip;
    width: 20px;
    height: 20px;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.accent;

        Text {
            text: "?";
            font-size: Theme.font-sm;
            font-weight: 700;
            color: Theme.accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: help;
    }

    if ta.has-hover: Rectangle {
        x: parent.width + 6px;
        y: parent.height / 2;
        background: Theme.dark ? #15151c : #1f2937;
        border-radius: Theme.radius-sm;
        border-color: Theme.border-strong;
        border-width: 1px;
        width: 320px;
        height: tip-text.preferred-height + 14px;

        tip-text := Text {
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            text: root.tip;
            color: white;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
    }
}
