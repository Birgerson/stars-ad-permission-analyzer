// The Analyze tab (ADR 0082): its state (`AnalyzeState`, read and written by
// src/tabs/analyze.rs) and its layout (`AnalyzeTab`).

import {
    VerticalBox,
    HorizontalBox,
    GridBox,
    GroupBox,
    LineEdit,
    Button,
    CheckBox,
    ScrollView,
    SpinBox,
    ComboBox,
} from "std-widgets.slint";
import { PrimaryButton } from "../components/buttons.slint";
import { HelpTip } from "../components/help-tip.slint";
import { TrustDomainFields } from "../components/trust-domain-fields.slint";
import {
    TrusteeRowVm,
    DiagnosticVm,
    StepVm,
    IdentitySuggestionVm,
} from "../models.slint";
import { Theme } from "../theme/theme.slint";

export global AnalyzeState {
    // Pre-fill the SYSVOL directory: exists on every default
    // Windows Server DC install, is audit-relevant (Group Policy
    // templates, login scripts) and saves the first keystroke. The
    // user can overwrite the path at any time — the property is
    // `in-out`.
    in-out property <string> path: "C:\\Windows\\SYSVOL\\sysvol";
    // User/group name as a convenient alternative to typing a SID
    // directly. `resolve-name-clicked` translates the name via LSA
    // into the SID and writes it to the SID field. The user can
    // still type a SID into the SID field directly.
    in-out property <string> name;
    in property <string> name-error;
    in property <[IdentitySuggestionVm]> suggestions;
    // Feedback line for the "Search AD" directory picker (match count,
    // "searching…", or an error). Separate from `status` so a directory
    // search never overwrites the analysis status.
    in property <string> search-status;
    in-out property <string> sid;
    // LDAP mode: 0 = off (SAM/LSA, recommended on DC),
    //            1 = LDAPS (encrypted, port 636),
    //            2 = plain LDAP (port 389, test only),
    //            3 = Global Catalog (LDAPS 3269),
    //            4 = signed LDAP (Kerberos sign & seal, port 389).
    in-out property <int>    ldap-mode: 0;
    in-out property <string> ldap-server;
    in-out property <string> ldap-base-dn;
    in-out property <string> ldap-bind-dn;
    in-out property <string> ldap-password;
    in-out property <int>    ldap-timeout: 10;
    // ADR 0078: optional trusted-domain connection.
    in-out property <bool>   trust-enabled: false;
    in-out property <string> trust-server;
    in-out property <string> trust-base-dn;
    in-out property <string> trust-bind-dn;
    in-out property <string> trust-password;
    in-out property <bool>   smb-enabled;
    in-out property <string> smb-server;
    in-out property <string> smb-share;
    in property <bool>   is-running;
    in property <string> status;
    in property <bool>   status-is-error;
    in property <string> rights-label;
    in property <string> mask-hex;
    in property <string> share-line;
    in property <[StepVm]> explanation;
    in-out property <bool> show-all-members: false;
    callback toggle-members();
    // Structured diagnostic markers of the analyzed permission
    // (gui review 2026-07-26, GUI-1). Empty = nothing to report.
    in property <[DiagnosticVm]> diagnostics;
    // Trustee view: path-centric listing of all ACEs without a fixed
    // identity.
    in property <[TrusteeRowVm]> trustees;
    in property <bool>           has-trustees;
    in property <bool>           trustees-running;
    callback clicked();
    callback trustees-clicked();
    callback resolve-name-clicked();
    callback name-edited(string);
    // (name, sid) — sid is non-empty only for a live directory hit, which
    // is filled directly; a local entry (empty sid) is resolved via LSA.
    callback pick-suggestion(string, string);
    // Runs a live LDAP directory search using the current identity text
    // and the Analyze tab's LDAP settings.
    callback search-directory-clicked();
}

export component AnalyzeTab inherits ScrollView {
    VerticalBox {
        // ADR 0083: every field at its natural height, from the top. Without
        // this, free height is shared out over all rows, so the fields grew
        // while the tab had room and shrank again as soon as the suggestion
        // list or a result took it.
        alignment: start;
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        GroupBox {
            title: "Target";
            VerticalBox {
                spacing: Theme.spacing-sm;
                GridBox {
                    spacing: Theme.spacing-sm;
                    Row {
                        Text { text: "Path:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "C:\\Folder  or  \\\\server\\share\\Folder";
                            text <=> AnalyzeState.path;
                        }
                    }
                    Row {
                        Text { text: "Identity:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "local name · DOMAIN\\user · user@domain.lab · S-1-5-21-…";
                            text <=> AnalyzeState.name;
                            edited(s) => { AnalyzeState.name-edited(s); }
                            accepted(s) => { AnalyzeState.resolve-name-clicked(); }
                        }
                    }
                    Row {
                        Text { text: ""; }
                        Text {
                            text: "One field for any identity — a local name, DOMAIN\\user, UPN, or a raw SID. Stars resolves it when you run; the suggestion list covers local accounts, and 'Resolve SID' is an optional preview.";
                            color: Theme.text-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    Row {
                        Text { text: ""; }
                        HorizontalBox {
                            alignment: start;
                            spacing: Theme.spacing-sm;
                            padding: 0px;
                            Button {
                                text: "Resolve SID";
                                clicked => { AnalyzeState.resolve-name-clicked(); }
                            }
                            Button {
                                text: "Search AD";
                                enabled: AnalyzeState.ldap-mode > 0;
                                clicked => { AnalyzeState.search-directory-clicked(); }
                            }
                            Text {
                                text: AnalyzeState.search-status;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Row {
                        Text { text: ""; }
                        if AnalyzeState.suggestions.length > 0: Rectangle {
                            background: Theme.bg-card;
                            border-color: Theme.border;
                            border-width: 1px;
                            border-radius: 4px;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 0px;
                                Text {
                                    text: "[L] = local identity of this machine";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                }
                                for sug[i] in AnalyzeState.suggestions: TouchArea {
                                    height: 24px;
                                    clicked => { AnalyzeState.pick-suggestion(sug.name, sug.sid); }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: Theme.spacing-sm;
                                        Text {
                                            text: "[" + sug.kind_icon + "]";
                                            color: Theme.text-secondary;
                                            width: 28px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: sug.qualified;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            width: 320px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: sug.description;
                                            color: Theme.text-muted;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Row {
                        Text { text: "Resolved SID:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "auto-filled when you run · or paste a SID directly";
                            text <=> AnalyzeState.sid;
                        }
                    }
                }
                if AnalyzeState.name-error != "": Text {
                    text: AnalyzeState.name-error;
                    color: Theme.error;
                    wrap: word-wrap;
                }
            }
        }

        GroupBox {
            title: "Identity resolution";
            VerticalBox {
                spacing: Theme.spacing-sm;
                HorizontalBox {
                    spacing: Theme.spacing-sm;
                    padding: 0px;
                    Text {
                        text: "Mode:";
                        vertical-alignment: center;
                        width: 110px;
                    }
                    ComboBox {
                        model: [
                            "Off — use SAM/LSA (recommended on a DC)",
                            "LDAPS — encrypted, port 636",
                            "Plain LDAP — port 389 (test only)",
                            "Global Catalog — forest-wide, port 3269 (LDAPS)",
                            "Signed LDAP — Kerberos sign & seal, port 389",
                        ];
                        current-index <=> AnalyzeState.ldap-mode;
                        horizontal-stretch: 1;
                    }
                    HelpTip {
                        tip: "How should identity and groups be resolved?\n\n• Off (recommended): uses the local Windows LSA/SAM. On a domain controller this returns complete data (users, global groups, local groups). No configuration, no certificate needed.\n\n• LDAPS: encrypted LDAP connection on port 636. Requires the DC to have a valid LDAPS certificate that this machine trusts (AD CS enterprise CA); a self-signed certificate is rejected. Connect by FQDN, not IP.\n\n• Plain LDAP: port 389, no TLS. For test environments only — transmits the password in cleartext, and is refused by hardened Windows Server 2022/2025 DCs (LDAP signing).\n\n• Global Catalog: forest-wide bind over LDAPS (port 3269). Base DN may be left empty. Same certificate requirement as LDAPS. Only universal groups replicate fully to the GC, so memberships are flagged potentially incomplete.\n\n• Signed LDAP: port 389 with Kerberos sign & seal — no certificate needed. The cert-free way to query a hardened DC that enforces LDAP signing. Uses the current Windows logon (no bind DN / password); Server must be the DC's FQDN. Run Stars as the domain account whose context you want.";
                    }
                }

                if AnalyzeState.ldap-mode > 0: GridBox {
                    spacing: Theme.spacing-sm;
                    Row {
                        Text { text: "Server:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "dc01.domain.local";
                            text <=> AnalyzeState.ldap-server;
                        }
                        HelpTip {
                            tip: "Fully qualified hostname (FQDN) of the domain controller.\n\nExample: dc01.company.local\n\nDo not enter a scheme prefix (no ldap:// or ldaps://) — the mode determines it.";
                        }
                    }
                    Row {
                        Text { text: "Base DN:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "DC=domain,DC=local";
                            text <=> AnalyzeState.ldap-base-dn;
                        }
                        HelpTip {
                            tip: "Distinguished Name of the domain root.\n\nExample: DC=company,DC=local\n\nComma-separated, no spaces after the commas. Derivable from the DNS domain: 'company.local' becomes 'DC=company,DC=local'.";
                        }
                    }
                    Row {
                        Text { text: "Bind DN:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "DOMAIN\\user  ·  user@domain  ·  CN=…,DC=…";
                            text <=> AnalyzeState.ldap-bind-dn;
                        }
                        HelpTip {
                            tip: "The account Stars binds with to read LDAP. Three forms are accepted (all valid for an AD simple bind):\n\n• DOMAIN\\user — e.g. RES\\labinsch\n• user@domain (UPN) — e.g. labinsch@res.lab\n• full DN — e.g. CN=Birger Labinsch,OU=Users,DC=res,DC=lab\n\nPrefer DOMAIN\\user or the UPN: they use the stable logon name (sAMAccountName), whereas a DN's CN is the display name and changes when the name does. A dedicated read-only service account is recommended, not the domain admin.";
                        }
                    }
                    Row {
                        Text { text: "Password:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            input-type: password;
                            text <=> AnalyzeState.ldap-password;
                        }
                        HelpTip {
                            tip: "Password for the bind-DN account.\n\nNot persisted, only held in memory for the running session. With 'Plain LDAP' it crosses the wire in cleartext — use only in test environments.";
                        }
                    }
                    Row {
                        Text { text: "Timeout (s):"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        SpinBox {
                            minimum: 1;
                            maximum: 600;
                            value <=> AnalyzeState.ldap-timeout;
                        }
                        HelpTip {
                            tip: "LDAP operation timeout in seconds (1–600, default 10).\n\nRaise this on large or deeply nested domains: the recursive membership query (LDAP_MATCHING_RULE_IN_CHAIN) can need longer than 10 s, otherwise resolution is reported as timed out and incomplete.";
                        }
                    }
                }
                if AnalyzeState.ldap-mode > 0: TrustDomainFields {
                    enabled <=> AnalyzeState.trust-enabled;
                    server <=> AnalyzeState.trust-server;
                    base-dn <=> AnalyzeState.trust-base-dn;
                    bind-dn <=> AnalyzeState.trust-bind-dn;
                    secret <=> AnalyzeState.trust-password;
                    signing: AnalyzeState.ldap-mode == 4;
                }
            }
        }

        GroupBox {
            title: "SMB share (optional, combines NTFS ∩ share)";
            VerticalBox {
                spacing: Theme.spacing-sm;
                CheckBox {
                    text: "Include share mask";
                    checked <=> AnalyzeState.smb-enabled;
                }
                if AnalyzeState.smb-enabled: GridBox {
                    spacing: Theme.spacing-sm;
                    Row {
                        Text { text: "Server:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "fileserver";
                            text <=> AnalyzeState.smb-server;
                        }
                    }
                    Row {
                        Text { text: "Share:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "data";
                            text <=> AnalyzeState.smb-share;
                        }
                    }
                }
            }
        }

        HorizontalBox {
            alignment: start;
            spacing: Theme.spacing-sm;
            PrimaryButton {
                text: AnalyzeState.is-running ? "Running..." : "Analyze";
                enabled: !AnalyzeState.is-running;
                clicked => { AnalyzeState.clicked(); }
            }
            // Second audit question: path-centric
            // trustee view. Needs no identity because
            // it lists every ACE on the path.
            Button {
                text: AnalyzeState.trustees-running ? "Running..." : "Who has access?";
                enabled: !AnalyzeState.trustees-running;
                clicked => { AnalyzeState.trustees-clicked(); }
            }
        }

        if AnalyzeState.status != "": Text {
            text: AnalyzeState.status;
            color: AnalyzeState.status-is-error ? Theme.error : Theme.text-primary;
            wrap: word-wrap;
        }

        Text {
            text: "Note: every analysis is stored automatically in the scan history and becomes comparable in the Delta tab.";
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        if AnalyzeState.rights-label != "": GroupBox {
            title: "Result";
            VerticalBox {
                spacing: 4px;
                Text {
                    text: "Effective rights: " + AnalyzeState.rights-label;
                    font-size: 16px;
                    // ADR 0080: a long rights list or the
                    // SYNCHRONIZE addition must not be cut off.
                    wrap: word-wrap;
                }
                Text {
                    text: "Access-Mask: " + AnalyzeState.mask-hex;
                    color: Theme.text-secondary;
                }
                if AnalyzeState.share-line != "": Text {
                    text: AnalyzeState.share-line;
                    color: Theme.text-secondary;
                }
                Text {
                    text: "Permission path:";
                    font-size: 14px;
                }
                // Review CR-12: in a long membership list
                // the memberships that did not matter are
                // collapsed behind one toggle line;
                // decisive, deny-only and uncertain ones
                // always stay visible.
                // The model holds only the visible steps
                // (Rust filters on toggle), so a collapsed
                // step leaves no gap in the layout.
                for step[i] in AnalyzeState.explanation: Text {
                    text: step.toggle
                        ? (AnalyzeState.show-all-members
                            ? "▲ Hide the " + step.hidden_count + " further memberships"
                            : "▼ Show " + step.hidden_count + " further memberships (not decisive for this result)")
                        : step.number + ". " + step.text;
                    color: step.toggle ? Theme.correct : Theme.text-primary;
                    wrap: word-wrap;
                    TouchArea {
                        enabled: step.toggle;
                        mouse-cursor: step.toggle ? pointer : default;
                        clicked => { AnalyzeState.toggle-members(); }
                    }
                }

                // GUI-1 (gui review 2026-07-26): the
                // structured diagnostic markers of THIS
                // result. Previously the Analyze tab
                // dropped them entirely, so an
                // understated right (unevaluated
                // sIDHistory) or a flat SAM fallback
                // looked like a clean, complete answer.
                // Same widget shape and wording as the
                // Groups tab and the scan rows.
                if AnalyzeState.diagnostics.length > 0: VerticalBox {
                    padding: 0px;
                    spacing: 2px;
                    Text {
                        text: "Diagnostics (" + AnalyzeState.diagnostics.length + "):";
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    for d in AnalyzeState.diagnostics: Text {
                        text: (d.level == 0 ? "[i] " : "[!] ") + d.text;
                        color: d.level == 2 ? Theme.danger
                             : d.level == 1 ? Theme.warning
                             : Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Trustee view: shows every ACE on the path,
        // independent of any identity token. Complement
        // to the identity-based effective analysis above.
        if AnalyzeState.has-trustees: GroupBox {
            title: "Who has access (" + AnalyzeState.trustees.length + " ACE entries)";
            VerticalBox {
                spacing: 4px;
                HorizontalBox {
                    spacing: Theme.spacing-sm;
                    Text { text: "Trustee"; font-weight: 700; horizontal-stretch: 2; }
                    Text { text: "Kind"; font-weight: 700; width: 70px; }
                    Text { text: "Rights"; font-weight: 700; width: 220px; }
                    Text { text: "Source"; font-weight: 700; width: 80px; }
                    Text { text: "Applies to"; font-weight: 700; width: 220px; }
                    Text { text: "Layer"; font-weight: 700; width: 70px; }
                }
                for t[i] in AnalyzeState.trustees: HorizontalBox {
                    spacing: Theme.spacing-sm;
                    Text {
                        text: t.display_name;
                        color: Theme.text-primary;
                        horizontal-stretch: 2;
                        overflow: elide;
                    }
                    Text {
                        text: t.kind;
                        color: t.kind_color;
                        width: 70px;
                    }
                    Text {
                        text: t.rights_label;
                        color: Theme.text-secondary;
                        width: 220px;
                        overflow: elide;
                    }
                    Text {
                        text: t.source;
                        color: Theme.text-secondary;
                        width: 80px;
                    }
                    Text {
                        text: t.applies_to;
                        color: Theme.text-secondary;
                        width: 220px;
                        overflow: elide;
                    }
                    Text {
                        text: t.category;
                        color: Theme.text-secondary;
                        width: 70px;
                    }
                }
            }
        }
    }
}
