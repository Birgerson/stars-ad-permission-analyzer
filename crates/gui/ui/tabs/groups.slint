// The Groups tab (ADR 0082): its state (`GroupsState`, read and written by
// src/tabs/groups.rs) and its layout (`GroupsTab`).

import {
    VerticalBox,
    HorizontalBox,
    GridBox,
    GroupBox,
    LineEdit,
    Button,
    ScrollView,
    SpinBox,
    ComboBox,
} from "std-widgets.slint";
import { HelpTip } from "../components/help-tip.slint";
import { TrustDomainFields } from "../components/trust-domain-fields.slint";
import { DiagnosticVm, GroupMemberVm, IdentitySuggestionVm } from "../models.slint";
import { Theme } from "../theme/theme.slint";

export global GroupsState {
    // ============================================================
    // Groups-Tab Properties / Groups tab properties
    // ============================================================
    // Single identity field (name · DOMAIN\user · UPN · SID); auto-
    // resolved like the Analyze/Scan tabs. No path — this tab answers
    // "which groups is this identity in?", not "what can it access?".
    in-out property <string> identity;
    // Direction: 0 = "Member of" (groups this identity is in, upward),
    // 1 = "Members" (who is in this group, downward). The downward view
    // requires LDAP and mirrors the CLI `members` command.
    in-out property <int>    direction: 0;
    // Set by the worker result so the labels match what was computed
    // (independent of the toggle, which the user may flip before re-running).
    in property <bool>       result-is-members;
    // Live suggestion list while typing the identity — same source and
    // behaviour as the Analyze tab (local NetAPI snapshot, filtered).
    in property <[IdentitySuggestionVm]> suggestions;
    // LDAP mode: 0 = off (SAM/LSA), 1 = LDAPS, 2 = plain LDAP, 3 = GC.
    in-out property <int>    ldap-mode: 0;
    in-out property <string> ldap-server;
    in-out property <string> ldap-base-dn;
    in-out property <string> ldap-bind-dn;
    in-out property <string> ldap-password;
    in-out property <int>    ldap-timeout: 10;
    // ADR 0078: optional trusted-domain connection.
    in-out property <bool>   trust-enabled: false;
    in-out property <string> trust-server;
    in-out property <string> trust-base-dn;
    in-out property <string> trust-bind-dn;
    in-out property <string> trust-password;
    in property <bool>   is-running;
    in property <string> status;
    in property <bool>   status-is-error;
    in property <bool>   has-result;
    in property <string> identity-label;
    in property <string> identity-sid;
    in property <string> identity-meta;
    in property <bool>   ad-connected;
    in property <int>    sid-history;
    in property <int>    total;
    in property <int>    direct;
    in property <bool>            has-privileged;
    in property <[string]>        privileged;
    in property <[GroupMemberVm]> groups;
    in property <[DiagnosticVm]>  diagnostics;
    callback resolve-clicked();
    callback name-edited(string);
    callback pick-suggestion(string);
}

export component GroupsTab inherits ScrollView {
    VerticalBox {
        // Pack the form at the top at natural heights — without
        // this the sparse Groups tab would distribute the spare
        // vertical space onto the input fields and inflate them.
        alignment: start;
        padding: Theme.spacing-md;
        spacing: Theme.spacing-sm;

        GroupBox {
            title: "Identity";
            VerticalBox {
                spacing: Theme.spacing-sm;
                HorizontalBox {
                    spacing: Theme.spacing-sm;
                    padding: 0px;
                    Text { text: "Direction:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                    ComboBox {
                        model: [
                            "Member of — groups this identity is in",
                            "Members — who is in this group",
                        ];
                        current-index <=> GroupsState.direction;
                        horizontal-stretch: 1;
                    }
                    HelpTip {
                        tip: "Which way to look?\n\n• Member of (upward): the recursive groups the identity belongs to. Works with or without LDAP (SAM/LSA on a DC covers direct groups).\n\n• Members (downward): who is in the given group — direct members plus accounts whose primary group it is (e.g. Domain Users). Requires LDAP; the local SAM/LSA path cannot enumerate domain-group members.";
                    }
                }
                Text {
                    text: GroupsState.direction == 1
                        ? "Who is in this group? Direct members + primary-group members (e.g. Domain Users). Requires LDAP. No path, no rights."
                        : "Which groups is a user (or group) in? Recursive memberships only — no path, no rights.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                GridBox {
                    spacing: Theme.spacing-sm;
                    Row {
                        Text { text: GroupsState.direction == 1 ? "Group:" : "Identity:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit {
                            placeholder-text: "local name · DOMAIN\\user · user@domain.lab · S-1-5-21-…";
                            text <=> GroupsState.identity;
                            edited(s) => { GroupsState.name-edited(s); }
                            accepted(s) => { GroupsState.resolve-clicked(); }
                        }
                    }
                    Row {
                        Text { text: ""; }
                        if GroupsState.suggestions.length > 0: Rectangle {
                            background: Theme.bg-card;
                            border-color: Theme.border;
                            border-width: 1px;
                            border-radius: 4px;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 0px;
                                Text {
                                    text: "[L] = local identity of this machine";
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                }
                                for sug[i] in GroupsState.suggestions: TouchArea {
                                    height: 24px;
                                    clicked => { GroupsState.pick-suggestion(sug.name); }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: Theme.spacing-sm;
                                        Text {
                                            text: "[" + sug.kind_icon + "]";
                                            color: Theme.text-secondary;
                                            width: 28px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: sug.qualified;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            width: 320px;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: sug.description;
                                            color: Theme.text-muted;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        GroupBox {
            title: "Identity resolution";
            VerticalBox {
                spacing: Theme.spacing-sm;
                HorizontalBox {
                    spacing: Theme.spacing-sm;
                    padding: 0px;
                    Text { text: "Mode:"; vertical-alignment: center; width: 110px; }
                    ComboBox {
                        model: [
                            "Off — use SAM/LSA (recommended on a DC)",
                            "LDAPS — encrypted, port 636",
                            "Plain LDAP — port 389 (test only)",
                            "Global Catalog — forest-wide, port 3269 (LDAPS)",
                            "Signed LDAP — Kerberos sign & seal, port 389",
                        ];
                        current-index <=> GroupsState.ldap-mode;
                        horizontal-stretch: 1;
                    }
                    HelpTip {
                        tip: "How should identity and groups be resolved?\n\n• Off (recommended): uses the local Windows LSA/SAM. On a domain controller this returns complete data (users, global groups, local groups). No configuration, no certificate needed.\n\n• LDAPS: encrypted LDAP connection on port 636. Requires the DC to have a valid LDAPS certificate that this machine trusts (AD CS enterprise CA); a self-signed certificate is rejected. Connect by FQDN, not IP.\n\n• Plain LDAP: port 389, no TLS. For test environments only — transmits the password in cleartext, and is refused by hardened Windows Server 2022/2025 DCs (LDAP signing).\n\n• Global Catalog: forest-wide bind over LDAPS (port 3269). Base DN may be left empty. Same certificate requirement as LDAPS. Only universal groups replicate fully to the GC, so memberships are flagged potentially incomplete.\n\n• Signed LDAP: port 389 with Kerberos sign & seal — no certificate needed. The cert-free way to query a hardened DC that enforces LDAP signing. Uses the current Windows logon (no bind DN / password); Server must be the DC's FQDN. Run Stars as the domain account whose context you want.";
                    }
                }
                if GroupsState.ldap-mode > 0: GridBox {
                    spacing: Theme.spacing-sm;
                    Row {
                        Text { text: "Server:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit { placeholder-text: "dc01.domain.local"; text <=> GroupsState.ldap-server; }
                        HelpTip {
                            tip: "Fully qualified hostname (FQDN) of the domain controller.\n\nExample: dc01.company.local\n\nDo not enter a scheme prefix (no ldap:// or ldaps://) — the mode determines it.";
                        }
                    }
                    Row {
                        Text { text: "Base DN:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit { placeholder-text: "DC=domain,DC=local"; text <=> GroupsState.ldap-base-dn; }
                        HelpTip {
                            tip: "Distinguished Name of the domain root.\n\nExample: DC=company,DC=local\n\nComma-separated, no spaces after the commas. Derivable from the DNS domain: 'company.local' becomes 'DC=company,DC=local'.";
                        }
                    }
                    Row {
                        Text { text: "Bind DN:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit { placeholder-text: "DOMAIN\\user  ·  user@domain  ·  CN=…,DC=…"; text <=> GroupsState.ldap-bind-dn; }
                        HelpTip {
                            tip: "The account Stars binds with to read LDAP. Three forms are accepted (all valid for an AD simple bind):\n\n• DOMAIN\\user — e.g. RES\\labinsch\n• user@domain (UPN) — e.g. labinsch@res.lab\n• full DN — e.g. CN=Birger Labinsch,OU=Users,DC=res,DC=lab\n\nPrefer DOMAIN\\user or the UPN: they use the stable logon name (sAMAccountName), whereas a DN's CN is the display name and changes when the name does. A dedicated read-only service account is recommended, not the domain admin.";
                        }
                    }
                    Row {
                        Text { text: "Password:"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        LineEdit { input-type: password; text <=> GroupsState.ldap-password; }
                        HelpTip {
                            tip: "Password for the bind-DN account.\n\nNot persisted, only held in memory for the running session. With 'Plain LDAP' it crosses the wire in cleartext — use only in test environments.";
                        }
                    }
                    Row {
                        Text { text: "Timeout (s):"; vertical-alignment: center; horizontal-stretch: 0; width: 140px; }
                        SpinBox { minimum: 1; maximum: 600; value <=> GroupsState.ldap-timeout; }
                        HelpTip {
                            tip: "LDAP operation timeout in seconds (1–600, default 10).\n\nRaise this on large or deeply nested domains: the recursive membership query (LDAP_MATCHING_RULE_IN_CHAIN) can need longer than 10 s, otherwise resolution is reported as timed out and incomplete.";
                        }
                    }
                }
                if GroupsState.ldap-mode > 0 && GroupsState.direction == 0: TrustDomainFields {
                    enabled <=> GroupsState.trust-enabled;
                    server <=> GroupsState.trust-server;
                    base-dn <=> GroupsState.trust-base-dn;
                    bind-dn <=> GroupsState.trust-bind-dn;
                    secret <=> GroupsState.trust-password;
                    signing: GroupsState.ldap-mode == 4;
                }
            }
        }

        HorizontalBox {
            alignment: start;
            spacing: Theme.spacing-sm;
            padding: 0px;
            Button {
                text: GroupsState.direction == 1 ? "Show members" : "Show groups";
                enabled: !GroupsState.is-running;
                clicked => { GroupsState.resolve-clicked(); }
            }
            Text {
                text: GroupsState.status;
                color: GroupsState.status-is-error ? Theme.error : Theme.text-secondary;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        if GroupsState.has-result: GroupBox {
            title: "Result";
            VerticalBox {
                spacing: Theme.spacing-sm;

                Text { text: GroupsState.identity-label; font-weight: 700; color: Theme.text-primary; }
                Text { text: GroupsState.identity-sid; color: Theme.text-secondary; font-size: 11px; }
                Text { text: GroupsState.identity-meta; color: Theme.text-secondary; }
                if GroupsState.sid-history > 0: Text {
                    text: "sIDHistory: " + GroupsState.sid-history + " (see diagnostics)";
                    color: Theme.danger;
                }
                if !GroupsState.ad-connected && !GroupsState.result-is-members: Text {
                    text: "[!] No AD/LDAP connection — only direct (SAM/LSA) groups resolved.";
                    color: Theme.warning;
                    wrap: word-wrap;
                }

                if GroupsState.has-privileged: Rectangle {
                    background: Theme.bg-card;
                    border-color: Theme.danger;
                    border-width: 1px;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for p in GroupsState.privileged: Text {
                            text: "[!] " + p;
                            color: Theme.danger;
                            font-weight: 700;
                        }
                    }
                }

                Text {
                    text: GroupsState.result-is-members
                        ? "Members (" + GroupsState.total + " total, " + GroupsState.direct + " direct, " + (GroupsState.total - GroupsState.direct) + " via primaryGroupID)"
                        : "Group memberships (" + GroupsState.total + " total, " + GroupsState.direct + " direct)";
                    font-weight: 700;
                    color: Theme.text-primary;
                }
                if GroupsState.total == 0: Text { text: GroupsState.result-is-members ? "(no members)" : "(none resolved)"; color: Theme.text-muted; }
                for g in GroupsState.groups: VerticalLayout {
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 0px;
                    HorizontalLayout {
                        spacing: Theme.spacing-sm;
                        Text {
                            text: g.name;
                            color: g.privileged ? Theme.danger : Theme.text-primary;
                            font-weight: g.privileged ? 700 : 400;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if g.privileged: Text {
                            text: "privileged: " + g.role;
                            color: Theme.danger;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: g.sid + "  ·  " + g.origin;
                        color: Theme.text-muted;
                        font-size: 11px;
                        overflow: elide;
                    }
                }

                if GroupsState.diagnostics.length > 0: VerticalBox {
                    padding: 0px;
                    spacing: 2px;
                    Text {
                        text: "Diagnostics (" + GroupsState.diagnostics.length + "):";
                        font-weight: 700;
                        color: Theme.text-primary;
                    }
                    for d in GroupsState.diagnostics: Text {
                        text: (d.level == 0 ? "[i] " : "[!] ") + d.text;
                        color: d.level == 2 ? Theme.danger
                             : d.level == 1 ? Theme.warning
                             : Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }

                Text {
                    text: "→ To check effective rights on a path, use the Analyze or Scan Tree tab.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
