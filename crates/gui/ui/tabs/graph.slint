// The Graph tab (ADR 0082): its state (`GraphState`, read and written by
// src/tabs/graph.rs) and its layout (`GraphTab`).

import { VerticalBox, LineEdit, Button, CheckBox, ScrollView } from "std-widgets.slint";
import { GraphTextVm, GraphNodeVm } from "../models.slint";
import { Theme } from "../theme/theme.slint";

export global GraphState {
    // ADR 0077: the permission graph of the last Analyze result — the
    // same SVG the HTML report embeds, rendered from the result's trace.
    in property <image>  image;
    // ADR 0081: the same shapes in the dark palette (Theme.dark picks).
    in property <image>  image-dark;
    in property <[GraphTextVm]> texts;
    in property <[GraphNodeVm]> nodes;
    in property <bool>   has-graph;
    // Zoom factor of the drawing (0.4–2.0), the selected box (-1: none)
    // and its full text.
    in-out property <float> zoom: 1.0;
    in-out property <int> selected: -1;
    in property <string> detail;
    callback node-clicked(int);
    // Save the graph as an SVG file.
    in-out property <string> save-path;
    in property <string> save-status;
    in property <bool> save-error;
    callback save-svg();
    // "Show all groups": every membership without an ACE as its own box.
    in-out property <bool> all-groups: false;
    callback toggle-all-groups();
    // The memberships no ACE on this object names (the "+N further
    // groups"), one per line; empty when there are none.
    in property <string> further-groups;
    in property <string> caption: "Run an analysis in the Analyze tab first — the graph shows its last result.";
}

export component GraphTab inherits VerticalBox {
    padding: Theme.spacing-md;
    spacing: Theme.spacing-sm;

    Text {
        text: GraphState.caption;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    Text {
        text: "Read left to right: account → token groups → ACEs → result per layer (NTFS on top, the share below) → effective result. Green: an Allow decided bits · red double line: a Deny decided bits · amber dashed: uncertain (counts only for certain logons) · grey dashed: no effect, inherit-only or deny-only · slate: the result of a layer · thick: the decisive route. Click a box for its full text and every route through it; click it again to show all. The numbered permission path in the Analyze tab is the full explanation.";
        color: Theme.text-muted;
        font-size: 11px;
        wrap: word-wrap;
    }
    if GraphState.has-graph: VerticalLayout {
        vertical-stretch: 1;
        spacing: Theme.spacing-sm;
        HorizontalLayout {
            spacing: Theme.spacing-sm;
            alignment: start;
            CheckBox {
                text: "Show all groups (also those no ACE on this object names)";
                checked <=> GraphState.all-groups;
                toggled => { GraphState.toggle-all-groups(); }
            }
            Button {
                text: "−";
                clicked => { GraphState.zoom = max(0.4, GraphState.zoom / 1.25); }
            }
            Text {
                text: round(GraphState.zoom * 100) + " %";
                vertical-alignment: center;
                color: Theme.text-secondary;
            }
            Button {
                text: "+";
                clicked => { GraphState.zoom = min(2.0, GraphState.zoom * 1.25); }
            }
            Button {
                text: "Actual size";
                clicked => { GraphState.zoom = 1.0; }
            }
            Button {
                text: "Fit width";
                clicked => {
                    GraphState.zoom = max(0.4, min(2.0, (gr-scroll.visible-width / 1px) / GraphState.image.width));
                }
            }
        }
        gr-scroll := ScrollView {
            vertical-stretch: 1;
            viewport-width: max(self.visible-width, GraphState.image.width * GraphState.zoom * 1px);
            viewport-height: max(self.visible-height, GraphState.image.height * GraphState.zoom * 1px);
            Image {
                x: 0px;
                y: 0px;
                width: GraphState.image.width * GraphState.zoom * 1px;
                height: GraphState.image.height * GraphState.zoom * 1px;
                source: Theme.dark ? GraphState.image-dark : GraphState.image;
            }
            for t in GraphState.texts: Text {
                x: t.x * GraphState.zoom * 1px;
                y: t.y * GraphState.zoom * 1px;
                text: t.text;
                font-size: 12px * GraphState.zoom;
                font-weight: t.bold ? 600 : 400;
                color: Theme.dark ? t.color-dark : t.color-light;
                opacity: t.faded ? 0.25 : 1.0;
            }
            for n in GraphState.nodes: TouchArea {
                x: n.x * GraphState.zoom * 1px;
                y: n.y * GraphState.zoom * 1px;
                width: n.w * GraphState.zoom * 1px;
                height: n.h * GraphState.zoom * 1px;
                mouse-cursor: pointer;
                clicked => { GraphState.node-clicked(n.index); }
            }
        }
        if GraphState.detail != "": Text {
            text: GraphState.detail;
            color: Theme.text-primary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.spacing-sm;
            LineEdit {
                placeholder-text: "C:\\Reports\\graph.svg";
                text <=> GraphState.save-path;
                horizontal-stretch: 1;
            }
            Button {
                text: "Save graph (SVG)";
                clicked => { GraphState.save-svg(); }
            }
        }
        if GraphState.save-status != "": Text {
            text: GraphState.save-status;
            color: GraphState.save-error ? Theme.error : Theme.text-secondary;
            wrap: word-wrap;
        }
    }
    if GraphState.has-graph && GraphState.further-groups != "": Text {
        text: GraphState.further-groups;
        color: Theme.text-secondary;
        font-size: 11px;
        wrap: word-wrap;
    }
    if !GraphState.has-graph: Rectangle { vertical-stretch: 1; }
}
